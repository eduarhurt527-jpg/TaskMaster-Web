PORT=3002
MAIN_API_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3002,http://localhost:3000

# Firebase (reutiliza la misma clave de servicio del proyecto principal)
FIREBASE_SERVICE_ACCOUNT_PATH=../taskmaster-web-dbcd0-firebase-adminsdk-fbsvc-ee2f4910e4.json

# Brevo (https://app.brevo.com -> SMTP & API -> API Keys)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@taskmaster.local
BREVO_SENDER_NAME=TaskMaster

# OAuth Google (Calendar, Drive y Classroom)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3002/auth/google/callback

# OAuth Microsoft (OneDrive y Teams)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:3002/auth/microsoft/callback

# Cifra access_token y refresh_token antes de guardarlos en Firestore.
# Genera una clave con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OAUTH_TOKEN_ENCRYPTION_KEY=
