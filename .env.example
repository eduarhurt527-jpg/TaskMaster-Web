# Copia este archivo como ".env" y completa los valores.

# Puerto del servidor Node/Express
PORT=3000

# Ruta al archivo JSON de credenciales de la cuenta de servicio de Firebase.
# Descárgalo desde: Firebase Console → Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada.
# Por defecto el servidor busca "./serviceAccountKey.json" si no se define esta variable.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# En Hostinger codifica el JSON completo en base64 y guárdalo como variable.
# Si se define, tiene prioridad sobre la ruta del archivo.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# En producción usa NODE_ENV=production para marcar la cookie como Secure.
NODE_ENV=development

# Orígenes permitidos, separados por coma. Vacío permite ejecución local en el mismo origen.
CORS_ORIGIN=http://localhost:3000

# Google Login de la aplicación principal (OAuth 2.0 / OpenID Connect).
# En Google Cloud agrega como URI de redirección:
# http://localhost:3000/api/auth/google/callback
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_INTEGRATION_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
YOUTUBE_INTEGRATION_REDIRECT_URI=http://localhost:3000/api/integrations/youtube/callback

# Clave base64 de 32 bytes para cifrar tokens OAuth. Genera con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_TOKEN_KEY=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/integrations/microsoft/callback
