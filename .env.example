# Copia este archivo como ".env" y completa los valores.

# Puerto del servidor Node/Express
PORT=3000

# Ruta al archivo JSON de credenciales de la cuenta de servicio de Firebase.
# Descárgalo desde: Firebase Console → Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada.
# Por defecto el servidor busca "./serviceAccountKey.json" si no se define esta variable.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Secreto largo y aleatorio para firmar la cookie de sesión.
# En producción genera al menos 32 bytes y no lo compartas ni lo subas a Git.
SESSION_SECRET=

# Origen permitido para solicitudes del navegador. Separa varios con coma.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002
